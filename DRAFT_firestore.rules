rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['displayName']) &&
             data.displayName is string && data.displayName.size() <= 50 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('currentStreak' in data) || data.currentStreak is number) &&
             (!('totalFocusTime' in data) || data.totalFocusTime is number) &&
             (!('weeklyFocus' in data) || (data.weeklyFocus is list && data.weeklyFocus.size() <= 7)) &&
             (!('currentTimer' in data) || (data.currentTimer is map));
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['name', 'code', 'creatorId', 'members']) &&
             data.name is string && data.name.size() <= 100 &&
             data.code is string && data.code.size() == 6 &&
             data.creatorId == request.auth.uid &&
             data.members is list && data.members.size() <= 100 &&
             data.members.size() > 0 &&
             data.members[0] is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'content', 'timestamp']) &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 50 &&
             data.content is string && data.content.size() <= 1000 &&
             data.timestamp == request.time;
    }

    // --- Collection Routes ---

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Used for member progress in groups
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Profile Update/Focus Sync
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currentStreak', 'totalFocusTime', 'weeklyFocus', 'lastSeen', 'currentTimer'])
      );
    }

    // GROUPS
    match /groups/{groupId} {
      allow get: if isSignedIn() && (request.auth.uid in existing().members);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.members);
      
      allow create: if isVerified() && isValidId(groupId) && isValidGroup(incoming());
      
      allow update: if isVerified() && (request.auth.uid in existing().members) && isValidGroup(incoming()) && (
        // Action: Join/Leave
        (incoming().diff(existing()).affectedKeys().hasOnly(['members'])) ||
        // Action: Rename (Owner only)
        (existing().creatorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name']))
      );
    }

    // MESSAGES
    match /groups/{groupId}/messages/{messageId} {
      // RELATIONAL CHECK: Must be member of the parent group
      function isGroupMember() {
        return isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
      }

      allow list: if isGroupMember();
      allow create: if isVerified() && isGroupMember() && isValidId(messageId) && isValidMessage(incoming());
    }
  }
}
